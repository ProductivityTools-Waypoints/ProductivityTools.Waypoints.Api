type Mutation{
    Hello(name: String!):String
    SaveRoute(route: RouteInput!):Route
    DeleteRoute(id: String!):String
    RemoveOdometers(id:String!):Route
    DuplicateRoute(id: String!):Route
}

type Query {
    helloQuery: String
    getRoutes:[Route]
    getRoute(id: ID!): Route
}

input RouteInput{
    id: ID
    source: String!
    route: String!
    destination: String!
    points: [pointInput]!

}
input pointInput{
    name: String!
    odometer: Int
    distance: Int
    comment: String
}

type Route{
    id: ID!,
    source: String,
    route: String,
    destination: String,
    points: [Point]
}

type Point {
    name: String
    odometer: Int
    distance: Int
    comment: String
}

